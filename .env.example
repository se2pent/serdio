# ===== Claudio 环境配置 =====
# 复制为 .env 并填入真实 Key

# --- 大脑（DeepSeek）---
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# --- 声音（小米 MiMo TTS，TTS 系列限时免费）---
MIMO_API_KEY=sk-xxxxxxxxxxxxxxxx
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_TTS_MODEL=mimo-v2.5-tts
MIMO_VOICE=default_zh

# --- 音乐（NeteaseCloudMusicApi 本地服务地址）---
NCM_API_BASE=http://localhost:3000

# --- 电台配置 ---
STATION_CITY=杭州
STATION_LAT=30.27
STATION_LON=120.15
PORT=8080

# --- 节律调度开关：定时推送聊天（晨间唤醒/时段编排/整点情绪检查）---
# 每次推送都会消耗 DeepSeek + TTS 额度；设为 false 关闭，DJ 只在你主动召唤时工作
SCHEDULER_ENABLED=true
